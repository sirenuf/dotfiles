# Full path because this is a global config.
config_dir=/etc/zsh
environment_dir=$config_dir/environment

source $config_dir/variables.zsh

# Make sure to set backend stuff first.
for file in $environment_dir/backend/*.zsh; do
  source $file;
done

for file in $environment_dir/shell/*.zsh; do
  source $file;
done

unset -m 'zcfg_*'

unset config_dir
unset environment_dir
unset file
