# Make sure this shit exists
mkdir -p "$ZDOTDIR" && touch "$ZDOTDIR/.zshrc"

# Always needs to be defined in each core file.
local zcfg_config_dir="/etc/zsh"
source "$zcfg_config_dir/variables.zsh"

# Make sure to set backend stuff first.
for file in $zcfg_environment_dir/backend/*.zsh; do
  source $file;
done

for file in $zcfg_environment_dir/shell/*.zsh; do
  source $file;
done

unset file
unset -m 'zcfg_*'
